<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Speaking Lab - Exercise & Health</title>

<style>
:root {
    --primary: #00c6ff;
    --accent: #0072ff;
    --bg-dark: #141e30;
    --card-bg: rgba(255, 255, 255, 0.08);
    --text-gold: #ffd700;
    --text-green: #00ff88;
    --text-danger: #ff5555;
}

* {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: linear-gradient(135deg, #141e30, #243b55);
    color: white;
    text-align: center;
    padding: 12px;
    margin: 0;
    min-height: 100vh;
}

.container {
    max-width: 600px;
    margin: auto;
}

h1 {
    font-size: 1.6rem;
    margin-top: 10px;
    margin-bottom: 5px;
}

h3 {
    font-size: 1rem;
    margin-top: 0;
}

.card {
    background: var(--card-bg);
    padding: 16px;
    border-radius: 16px;
    margin-top: 15px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.4);
    border: 1px solid rgba(255,255,255,0.1);
}

.cefr-bar {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: rgba(0,0,0,0.3);
    padding: 10px;
    border-radius: 10px;
    margin-bottom: 12px;
    border: 1px solid var(--primary);
}

@media (min-width: 480px) {
    .cefr-bar {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }
}

.cefr-bar select {
    background: #0f2334;
    color: var(--primary);
    border: 1px solid var(--primary);
    padding: 8px;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: bold;
    width: 100%;
}

button {
    width: 100%;
    padding: 14px;
    margin: 5px 0;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    background: var(--primary);
    color: #141e30;
    font-weight: bold;
    font-size: 1rem;
    transition: background 0.2s ease, transform 0.1s ease;
    touch-action: manipulation;
}

button:active {
    transform: scale(0.98);
}

button:disabled {
    background: #555 !important;
    color: #888 !important;
    transform: none;
    cursor: not-allowed;
}

.button-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.btn-rec {
    background: var(--text-gold);
    color: #000;
}

.btn-rec.recording {
    background: var(--text-danger);
    color: white;
    animation: pulse 1.5s infinite;
}

.result {
    text-align: left;
    margin-top: 15px;
    background: rgba(0,0,0,0.4);
    padding: 12px;
    border-radius: 10px;
    border-left: 4px solid var(--primary);
}

.live-stream {
    font-size: 1rem;
    line-height: 1.5;
    min-height: 40px;
    word-wrap: break-word;
}

.interim-text {
    color: #aaa;
    font-style: italic;
}

.highlight {
    background: rgba(255, 85, 85, 0.3);
    color: #ff7675;
    padding: 2px 4px;
    border-radius: 4px;
}

.good-word {
    color: var(--text-green);
    font-weight: bold;
}

.nav-controls {
    display: flex;
    gap: 10px;
    margin-top: 15px;
}

.nav-controls button {
    flex: 1;
}

@keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(255, 85, 85, 0.7); }
    70% { box-shadow: 0 0 0 10px rgba(255, 85, 85, 0); }
    100% { box-shadow: 0 0 0 0 rgba(255, 85, 85, 0); }
}
</style>
</head>

<body>

<div class="container">
<h1>Conversational Practice</h1>
<h3 style="color: var(--primary);">Prepared by Coach Carlos O.</h3>

<div id="setupCard" class="card">
    <p style="font-size: 0.95rem;">Select your CEFR Target Level to adjust strictness and evaluation thresholds:</p>
    <select id="startCefrLevel" style="padding: 12px; border-radius: 8px; font-size: 1rem; width: 100%;">
        <option value="A1">A1 - Beginner (Short answers)</option>
        <option value="A2">A2 - Elementary (Basic sentences)</option>
        <option value="B1" selected>B1 - Intermediate (Moderate depth)</option>
        <option value="B2">B2 - Upper-Intermediate (Strict fluency)</option>
        <option value="C1">C1 - Advanced (Complex vocabulary)</option>
    </select>
    <br><br>
    <button onclick="startExam()">Start Conversation Practice</button>
</div>

<div id="app" class="card" style="display:none;"></div>
</div>

<script>

// EXERCISE QUESTIONS & KEYWORDS
const questions = [
    { text: "Do you think exercising in the morning is a good idea? Why?", keywords: ["exercise", "morning", "idea", "energy", "start", "day", "routine", "wake"] },
    { text: "What are the advantages of having an exercise routine?", keywords: ["advantages", "routine", "health", "habit", "consistent", "strong", "body", "fit"] },
    { text: "Why do some people find it difficult to exercise regularly?", keywords: ["difficult", "regularly", "time", "busy", "tired", "lazy", "work", "motivation"] },
    { text: "Would you prefer running in a park or exercising in a gym? Why?", keywords: ["prefer", "running", "park", "gym", "outside", "nature", "equipment", "weather"] },
    { text: "How important is it to have a healthy lifestyle?", keywords: ["important", "healthy", "lifestyle", "food", "sleep", "mind", "life", "prevent"] },
    { text: "What activities can people do if they don't like running?", keywords: ["activities", "running", "walking", "swimming", "cycling", "yoga", "sports", "dance"] },
    { text: "Do you think friends can motivate each other to exercise?", keywords: ["friends", "motivate", "together", "support", "fun", "accountable", "push", "partner"] },
    { text: "How can people find a good balance between work, exercise, and free time?", keywords: ["balance", "work", "exercise", "free", "time", "schedule", "plan", "priorities"] }
];

const cefrConfig = {
    'A1': { minWords: 4,  targetWPM: 60,  bandBase: "4.0 - 4.5" },
    'A2': { minWords: 8,  targetWPM: 80,  bandBase: "5.0 - 5.5" },
    'B1': { minWords: 14, targetWPM: 100, bandBase: "6.0 - 6.5" },
    'B2': { minWords: 22, targetWPM: 120, bandBase: "7.0 - 7.5" },
    'C1': { minWords: 30, targetWPM: 140, bandBase: "8.0 - 9.0" }
};

let current = 0;
let currentCefr = 'B1';
let finalTranscript = "";
let recognition = null;
let mediaRecorder = null, audioChunks = [], audioURL = null;
let globalMicStream = null; // Unified stream reference
let isRecording = false;
let startTime, endTime;
let americanVoice = null;

// INITIALIZE VOICE SYNTHESIS
function initVoices() {
    if ('speechSynthesis' in window) {
        let voices = speechSynthesis.getVoices();
        americanVoice = voices.find(v => v.lang === 'en-US' && (v.name.includes('Natural') || v.name.includes('Google') || v.name.includes('Samantha') || v.name.includes('Alex'))) 
                      || voices.find(v => v.lang === 'en-US') 
                      || voices.find(v => v.lang.startsWith('en'));
    }
}
if ('speechSynthesis' in window) {
    speechSynthesis.onvoiceschanged = initVoices;
    initVoices();
}

// SINGLE-PROMPT MIC INITIALIZATION
async function initGlobalMic() {
    if (globalMicStream && globalMicStream.active) return true;
    try {
        globalMicStream = await navigator.mediaDevices.getUserMedia({ audio: true });
        return true;
    } catch (err) {
        alert("Microphone permission is required to use the Speaking Lab.");
        return false;
    }
}

// START EXAM - PERMISSION REQUESTED ONCE HERE
async function startExam() {
    currentCefr = document.getElementById("startCefrLevel").value;
    
    let micGranted = await initGlobalMic();
    if (!micGranted) return;

    document.getElementById("setupCard").style.display = "none";
    document.getElementById("app").style.display = "block";
    current = 0;
    loadQuestion();
}

// LOAD QUESTION UI
function loadQuestion() {
    if (current >= questions.length) {
        finish();
        return;
    }

    finalTranscript = "";

    const app = document.getElementById("app");
    app.innerHTML = `
        <div class="cefr-bar">
            <div><strong>Question ${current + 1} of ${questions.length}</strong></div>
            <div>
                <select id="cefrSelect" onchange="updateCefrLevel(this.value)">
                    <option value="A1" ${currentCefr==='A1'?'selected':''}>A1 Beginner</option>
                    <option value="A2" ${currentCefr==='A2'?'selected':''}>A2 Elementary</option>
                    <option value="B1" ${currentCefr==='B1'?'selected':''}>B1 Intermediate</option>
                    <option value="B2" ${currentCefr==='B2'?'selected':''}>B2 Upper-Inter.</option>
                    <option value="C1" ${currentCefr==='C1'?'selected':''}>C1 Advanced</option>
                </select>
            </div>
        </div>

        <p style="font-size: 1.15rem; color: var(--text-gold); font-weight: bold; text-align: left; margin: 15px 0;">${questions[current].text}</p>

        <div class="button-group">
            <button onclick="speakQuestion()">🔊 Listen Prompt (US Voice)</button>
            <button onclick="shadowMode()">🔁 Repeat After Me (Slow)</button>
            <button id="recBtn" class="btn-rec" onclick="startRecording()">🎙️ Start Speaking</button>
            <button id="stopBtn" onclick="stopRecording()" disabled>⏹ Stop</button>
            <button id="playBtn" onclick="playAudio()" disabled>🔊 Listen Playback</button>
        </div>

        <audio id="audioPlayer" playsinline></audio>

        <div id="status" style="margin-top: 10px; font-size: 0.9rem; font-style: italic; color: var(--primary);">Ready...</div>

        <div class="result">
            <p style="margin-top: 0; font-size: 0.9rem;"><b>Speech Stream:</b></p>
            <div id="liveText" class="live-stream">Tap "Start Speaking" to begin transcribing...</div>
            <div id="feedback" style="margin-top: 10px;"></div>
        </div>

        <div class="nav-controls">
            <button id="prevBtn" onclick="navigateQuestion(-1)" ${current===0?'disabled':''}>⬅️ Prev</button>
            <button id="nextBtn" onclick="analyze()" disabled>Submit ➡️</button>
        </div>
    `;
}

function updateCefrLevel(newLevel) {
    currentCefr = newLevel;
    const status = document.getElementById("status");
    if (status) status.innerText = `Target level: ${currentCefr}`;
}

function navigateQuestion(dir) {
    if (isRecording) stopRecording();
    current += dir;
    if (current < 0) current = 0;
    loadQuestion();
}

// TEXT TO SPEECH
function speakQuestion() {
    speechSynthesis.cancel();
    let u = new SpeechSynthesisUtterance(questions[current].text);
    u.lang = "en-US";
    if (americanVoice) u.voice = americanVoice;
    speechSynthesis.speak(u);
}

function shadowMode() {
    speechSynthesis.cancel();
    let u = new SpeechSynthesisUtterance(questions[current].text);
    u.lang = "en-US";
    if (americanVoice) u.voice = americanVoice;
    u.rate = 0.75;
    speechSynthesis.speak(u);
    document.getElementById("status").innerText = "Listen closely and repeat...";
}

// RECORDING - REUSES AUTHORIZED STREAM WITHOUT ASKING PERMISSION AGAIN
function startRecording() {
    if (!globalMicStream) {
        alert("Microphone stream lost. Please refresh.");
        return;
    }

    mediaRecorder = new MediaRecorder(globalMicStream);
    audioChunks = [];

    mediaRecorder.ondataavailable = e => {
        if (e.data.size > 0) audioChunks.push(e.data);
    };

    mediaRecorder.start();
    initSpeechRecognition();

    startTime = new Date();
    isRecording = true;

    document.getElementById("status").innerText = "Listening... Speak naturally!";
    document.getElementById("recBtn").classList.add("recording");
    document.getElementById("recBtn").innerText = "🎙️ Recording...";
    document.getElementById("recBtn").disabled = true;
    document.getElementById("stopBtn").disabled = false;
}

// SPEECH RECOGNITION TRANSCRIPTION
function initSpeechRecognition() {
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SpeechRecognition) {
        alert("Speech Recognition API is not supported in this browser.");
        return;
    }

    if (recognition) {
        try { recognition.stop(); } catch(e){}
    }

    recognition = new SpeechRecognition();
    recognition.lang = "en-US";
    recognition.continuous = true;
    recognition.interimResults = true;

    finalTranscript = "";

    recognition.onresult = e => {
        let interimTranscript = "";
        for (let i = e.resultIndex; i < e.results.length; i++) {
            let t = e.results[i][0].transcript;
            if (e.results[i].isFinal) {
                finalTranscript += t + " ";
            } else {
                interimTranscript += t;
            }
        }

        const liveEl = document.getElementById("liveText");
        if (liveEl) {
            liveEl.innerHTML = `${finalTranscript}<span class="interim-text">${interimTranscript}</span>`;
        }
    };

    recognition.onend = () => {
        if (isRecording && recognition) {
            try { recognition.start(); } catch(e) {}
        }
    };

    try {
        recognition.start();
    } catch(e) {}
}

function stopRecording() {
    isRecording = false;
    endTime = new Date();

    if (recognition) {
        recognition.onend = null;
        try { recognition.stop(); } catch(e) {}
    }

    if (mediaRecorder && mediaRecorder.state !== "inactive") {
        mediaRecorder.stop();
        mediaRecorder.onstop = () => {
            const blob = new Blob(audioChunks, { type: "audio/webm" });
            audioURL = URL.createObjectURL(blob);

            const player = document.getElementById("audioPlayer");
            player.src = audioURL;

            document.getElementById("status").innerText = "Audio captured.";
            document.getElementById("recBtn").classList.remove("recording");
            document.getElementById("recBtn").innerText = "🎙️ Start Speaking";
            document.getElementById("recBtn").disabled = false;
            document.getElementById("stopBtn").disabled = true;
            document.getElementById("playBtn").disabled = false;
            document.getElementById("nextBtn").disabled = false;
        };
    }
}

function playAudio() {
    const player = document.getElementById("audioPlayer");
    if (!player.src) {
        alert("No audio recorded.");
        return;
    }
    player.currentTime = 0;
    player.play();
    document.getElementById("status").innerText = "Playing audio...";
}

// ANALYSIS & DIAGNOSTICS
function highlightErrorsAndKeywords(text, targetKeywords) {
    let fillers = ["um", "uh", "like", "you know", "er", "ah"];
    let words = text.toLowerCase().replace(/[^a-z0-9\s]/g, '').split(/\s+/).filter(w => w.length > 0);

    return words.map((w, i) => {
        if (fillers.includes(w)) {
            return `<span class="highlight">${w}</span>`;
        }
        if (i > 0 && w === words[i - 1]) {
            return `<span class="highlight">${w}</span>`;
        }
        if (targetKeywords.includes(w)) {
            return `<span class="good-word">${w}</span>`;
        }
        return w;
    }).join(" ");
}

function analyze() {
    let cleanText = finalTranscript.trim().toLowerCase().replace(/[^a-z0-9\s]/g, '');
    let words = cleanText.split(/\s+/).filter(w => w.length > 0);
    let wordCount = words.length;

    let durationSec = (endTime - startTime) ? ((endTime - startTime) / 1000) : 1;
    let durationMin = Math.max(durationSec / 60, 0.05);
    let speedWPM = Math.round(wordCount / durationMin);

    const config = cefrConfig[currentCefr];
    const currentQuestionData = questions[current];

    let formattedText = highlightErrorsAndKeywords(cleanText, currentQuestionData.keywords);
    document.getElementById("liveText").innerHTML = formattedText || "<em>No speech recorded. Please try again.</em>";

    let feedbackStatus = "";
    let isLengthPass = wordCount >= config.minWords;
    let isFluencyPass = speedWPM >= (config.targetWPM - 20);

    if (isLengthPass && isFluencyPass) {
        feedbackStatus = `<span style="color: var(--text-green); font-weight: bold;">PASSED LEVEL (${currentCefr})</span>`;
    } else if (!isLengthPass) {
        feedbackStatus = `<span style="color: var(--text-danger); font-weight: bold;">EXPAND RESPONSE</span> (Aim for ${config.minWords}+ words)`;
    } else {
        feedbackStatus = `<span style="color: var(--text-gold); font-weight: bold;">INCREASE SPEED</span> (Target: ${config.targetWPM} WPM)`;
    }

    let feedbackHTML = `
        <div style="background: rgba(255,255,255,0.05); padding: 10px; border-radius: 8px; font-size: 0.9rem;">
            <p><strong>Result:</strong> ${feedbackStatus}</p>
            <p><strong>Metrics:</strong> ${wordCount} words | ${durationSec.toFixed(1)}s | ${speedWPM} WPM</p>
        </div>
        <br>
        <button onclick="downloadFeedback()">📝 Download Report</button>
        <button onclick="advanceNextDirectly()">Next Question ➜</button>
    `;

    document.getElementById("feedback").innerHTML = feedbackHTML;
    document.getElementById("status").innerText = "Done.";
}

function advanceNextDirectly() {
    current++;
    loadQuestion();
}

function downloadFeedback() {
    let reportText = `Conversational Practice Report\n`;
    reportText += `Coach: Carlos O.\n`;
    reportText += `Level: ${currentCefr}\n`;
    reportText += `Question: ${questions[current].text}\n`;
    reportText += `Transcript: ${finalTranscript}\n`;

    let blob = new Blob([reportText], { type: "text/plain" });
    let link = document.createElement("a");
    link.href = URL.createObjectURL(blob);
    link.download = `Practice_Q${current + 1}.txt`;
    link.click();
}

function finish() {
    document.getElementById("app").innerHTML = `
        <h2 style="color: var(--text-green);">Practice Complete!</h2>
        <p>Great job working through all conversation topics!</p>
        <button onclick="location.reload()">Restart Practice</button>
    `;
}

</script>
</body>
</html>
